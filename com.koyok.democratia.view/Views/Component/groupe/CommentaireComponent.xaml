<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="com.koyok.democratia.UI.Component.groupe.CommentaireComponent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:com.koyok.democratia.Domain.Models;assembly=com.koyok.democratia.core"
    x:Name="this"
    x:DataType="models:Commentaire"
    HorizontalOptions="Center"
    Style="{DynamicResource ContenViewStyle}">
    <HorizontalStackLayout Spacing="{DynamicResource SpacingLarge}">
        <Grid
            x:Name="grille"
            AutomationId="grille"
            ColumnDefinitions="Auto"
            RowDefinitions="Auto">
            <Ellipse
                Grid.Row="0"
                Grid.Column="0"
                AutomationId="commentaireEllipse"
                BackgroundColor="{Binding Couleur, Source={x:Reference this}}"
                HeightRequest="{DynamicResource SpacingLarge}"
                WidthRequest="{DynamicResource SpacingLarge}" />
            <Label
                x:Name="sigleLabel"
                Grid.Row="0"
                Grid.Column="0"
                AutomationId="sigleLabel"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                VerticalOptions="Center"
                VerticalTextAlignment="Center" />
        </Grid>
        <VerticalStackLayout Spacing="{DynamicResource SpacingSmall}">
            <Label
                x:Name="nameAuteur"
                AutomationId="nameAuteurLabel"
                HorizontalOptions="Center"
                Style="{DynamicResource LabelStyle}"
                VerticalOptions="Center" />
            <Label
                AutomationId="contenuMessageLabel"
                HorizontalOptions="Center"
                Style="{DynamicResource LabelStyle}"
                Text="{Binding contenuMessage}"
                VerticalOptions="Center" />
        </VerticalStackLayout>
    </HorizontalStackLayout>
</ContentView>
