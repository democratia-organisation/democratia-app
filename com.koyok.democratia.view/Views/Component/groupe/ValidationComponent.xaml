<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="com.koyok.democratia.UI.Component.groupe.ValidationComponent"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="this">
    <HorizontalStackLayout Spacing="{DynamicResource SpacingMedium}">
        <Label
            x:Name="textLabel"
            AutomationId="textLabel"
            Style="{DynamicResource LabelStyle}"
            Text="{Binding Source={x:Reference this}, Path=Text}" />
        <CheckBox x:Name="valueCheckBox" AutomationId="valueCheckBox" />
    </HorizontalStackLayout>
</ContentView>
