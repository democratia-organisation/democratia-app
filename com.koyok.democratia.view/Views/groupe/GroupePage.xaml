<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="com.koyok.democratia.UI.groupe.GroupePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:comp="clr-namespace:com.koyok.democratia.UI.Component"
    xmlns:enum="clr-namespace:com.koyok.democratia.Lib;assembly=com.koyok.democratia.core"
    xmlns:groupeComp="clr-namespace:com.koyok.democratia.UI.Component.groupe"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:lang="clr-namespace:com.koyok.democratia.view.Resources.Localization"
    xmlns:lib="clr-namespace:com.koyok.democratia.Lib;assembly=com.koyok.democratia.core"
    xmlns:models="clr-namespace:com.koyok.democratia.Domain.Models;assembly=com.koyok.democratia.core"
    xmlns:res="clr-namespace:com.koyok.democratia.view.Resources.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModel="clr-namespace:com.koyok.democratia.UI.groupe;assembly=com.koyok.democratia.core"
    Title="{Binding groupe.nomGroupe}"
    x:DataType="viewModel:GroupeViewModel"
    Style="{DynamicResource fondEcran}">
    <Grid
        x:Name="mainGrille"
        Padding="10"
        RowDefinitions="Auto, Auto, Auto, *, Auto"
        RowSpacing="{DynamicResource SpacingSmall}">

        <Image
            x:Name="groupeImage"
            Grid.Row="0"
            AutomationId="groupeImage"
            HeightRequest="{DynamicResource SpacingUltraLarge}"
            Source="{Binding image}"
            WidthRequest="{DynamicResource SpacingUltraLarge}" />

        <Grid
            x:Name="parametingGrille"
            Grid.Row="1"
            BackgroundColor="{AppThemeBinding Light={DynamicResource Light-surfaceContainer},
                                              Dark={DynamicResource Dark-surfaceContainer}}"
            ColumnDefinitions="Auto, *, Auto">

            <ImageButton
                x:Name="groupeImageButton"
                Grid.Column="0"
                AutomationId="groupeImageButton"
                Command="{Binding NavigateTappedCommand}"
                CommandParameter="Membre"
                HeightRequest="{DynamicResource SpacingLarge}"
                Source="groupe.png"
                WidthRequest="{DynamicResource SpacingLarge}" />

            <Label
                x:Name="nomGroupeLabel"
                Grid.Column="1"
                AutomationId="nomGroupeLabel"
                Style="{DynamicResource SubHeadlineStyle}"
                Text="{Binding groupe.nomGroupe}"
                VerticalOptions="Center" />

            <HorizontalStackLayout
                Grid.Column="2"
                IsVisible="{Binding groupe.isAdmin}"
                Spacing="{DynamicResource SpacingSmall}">
                <ImageButton
                    x:Name="rouageImageButton"
                    AutomationId="rouageImageButton"
                    Command="{Binding NavigateTappedCommand}"
                    CommandParameter="Parametre"
                    HeightRequest="{DynamicResource SpacingLarge}"
                    Source="rouage.png"
                    WidthRequest="{DynamicResource SpacingLarge}" />
                <ImageButton
                    x:Name="loupeImageButton"
                    AutomationId="loupeImageButton"
                    Command="{Binding NavigateTappedCommand}"
                    CommandParameter="DecideurPage"
                    HeightRequest="{DynamicResource SpacingLarge}"
                    Source="loupe.png"
                    WidthRequest="{DynamicResource SpacingLarge}" />
            </HorizontalStackLayout>
        </Grid>

        <HorizontalStackLayout
            Grid.Row="2"
            HorizontalOptions="Start"
            Spacing="{DynamicResource SpacingMedium}">
            <Picker
                x:Name="criterePicker"
                Title="{x:Static res:AppResources.critere}"
                Grid.Column="0"
                ios:Picker.UpdateMode="WhenFinished"
                AutomationId="criterePicker"
                ItemsSource="{enum:CritereMarkup {x:Type enum:Critere}}"
                SelectedItem="{Binding critere}">
                <Picker.Behaviors>
                    <toolkit:EventToCommandBehavior Command="{Binding ClasserPropositionsCommand}" EventName="SelectedIndexChanged" />
                </Picker.Behaviors>
            </Picker>
            <VerticalStackLayout Grid.Column="1" IsVisible="{Binding groupe.isAdmin}">
                <Label
                    HorizontalOptions="Center"
                    Style="{DynamicResource SubHeadlineStyle}"
                    Text="{x:Static lang:AppResources.filtre}" />
                <HorizontalStackLayout
                    RadioButtonGroup.GroupName="FilterGroup"
                    RadioButtonGroup.SelectedValue="{Binding complexFilter}"
                    Spacing="{DynamicResource SpacingSmall}">
                    <RadioButton
                        x:Name="radioButtonMaxSatisfactionMinBudget"
                        AutomationId="radioButtonMaxSatisfactionMinBudget"
                        Content="{x:Static lang:AppResources.MaxsatisfactionMinBudget}"
                        Value="{x:Static enum:ComplexFilterEnum.MaxSatisfactionMinBudget}" />
                    <RadioButton
                        x:Name="radioButtonPlusGrandeSatisfactionTheme"
                        AutomationId="radioButtonPlusGrandeSatisfactionTheme"
                        Content="{x:Static lang:AppResources.satisfactionTheme}"
                        Value="{x:Static enum:ComplexFilterEnum.PlusGrandeSatisfactionTheme}" />
                    <RadioButton
                        x:Name="radioButtonPropositionsTheme"
                        AutomationId="radioButtonPropositionsTheme"
                        Content="{x:Static lang:AppResources.pluspropotheme}"
                        Value="{x:Static enum:ComplexFilterEnum.PlusPropositionsTheme}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button
                x:Name="filterButton"
                AutomationId="filterButton"
                Command="{Binding FiltrerPropositionsCommand}"
                HeightRequest="{DynamicResource SpacingMedium}"
                IsVisible="{Binding groupe.isAdmin}"
                Text="{x:Static lang:AppResources.filtrer}"
                WidthRequest="{DynamicResource SpacingExtraLarge}" />
        </HorizontalStackLayout>

        <comp:RefreshView
            Grid.Row="3"
            ChargerElementsCommand="{Binding InitialisationElementsCommand}"
            Elements="{Binding propositions}"
            IsRefreshing="{Binding isRefreshing}"
            Size="{StaticResource SpacingSmall}"
            UpdateElementsCommand="{Binding UpdateListCommand}">
            <comp:RefreshView.ItemTemplate>
                <DataTemplate>
                    <groupeComp:PropositionCard
                        EnableLoupe="{Binding groupe.isAdmin}"
                        OpenCommand="{Binding BindingContext.OuvrirPropositionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                        OpenDetailCommand="{Binding BindingContext.OuvrirDetailPropositionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                </DataTemplate>
            </comp:RefreshView.ItemTemplate>
        </comp:RefreshView>

        <Button
            x:Name="nouvellePropositionButton"
            Grid.Row="4"
            AutomationId="nouvellePropositionButton"
            Command="{Binding NavigateTappedCommand}"
            CommandParameter="NouvelleProposition"
            Text="{x:Static res:AppResources.nouvellProp}"
            VerticalOptions="End" />
    </Grid>
</ContentPage>