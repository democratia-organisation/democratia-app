<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="com.koyok.democratia.UI.groupe.PropositionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:component="clr-namespace:com.koyok.democratia.UI.Component"
    xmlns:groupeComponent="clr-namespace:com.koyok.democratia.UI.Component.groupe"
    xmlns:lang="clr-namespace:com.koyok.democratia.view.Resources.Localization"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModel="clr-namespace:com.koyok.democratia.UI.groupe;assembly=com.koyok.democratia.core"
    x:Name="this"
    Title="PropositionPage"
    x:DataType="viewModel:PropositionViewModel"
    Style="{DynamicResource fondEcran}">
    <Grid
        HorizontalOptions="Fill"
        RowDefinitions="Auto, Auto ,*, Auto, Auto"
        RowSpacing="{DynamicResource SpacingMedium}"
        VerticalOptions="Fill">
        <Grid
            Grid.Row="0"
            BackgroundColor="{Binding groupe.couleurGroupe}"
            ColumnDefinitions="*, Auto">
            <Label
                Grid.Column="0"
                HorizontalOptions="Center"
                Style="{DynamicResource HeadlineStyle}"
                Text="{Binding proposition.titre}" />
            <ImageButton
                Grid.Column="1"
                HeightRequest="{DynamicResource SpacingLarge}"
                HorizontalOptions="End"
                Source="parametre.png"
                WidthRequest="{DynamicResource SpacingLarge}" />
        </Grid>
        <Label
            Grid.Row="1"
            HorizontalOptions="Center"
            Style="{DynamicResource SubHeadlineStyle}"
            Text="{Binding proposition.description}"
            VerticalOptions="Center" />
        <component:RefreshView
            Grid.Row="2"
            ChargerElementsCommand="{Binding LoadCommentairesCommand}"
            Elements="{Binding commentaires}"
            HorizontalOptions="Center"
            IsRefreshing="{Binding isRefreshing}"
            Size="{StaticResource SpacingVerySmall}"
            UpdateElementsCommand="{Binding RechargerElementsCommand}">
            <component:RefreshView.ItemTemplate>
                <DataTemplate>
                    <groupeComponent:CommentaireComponent Couleur="{Binding BindingContext.groupe.couleurGroupe, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                </DataTemplate>
            </component:RefreshView.ItemTemplate>
        </component:RefreshView>
        <Entry
            x:Name="commentaireEntry"
            Grid.Row="3"
            IsVisible="False"
            Text="{Binding commentaire}" />
        <Button
            x:Name="messagePostButton"
            Grid.Row="4"
            Clicked="PostMessageButton_Clicked"
            IsVisible="True"
            Text="{x:Static lang:AppResources.messagePost}" />
        <Button
            x:Name="valideButton"
            Grid.Row="4"
            Clicked="ValideButton_Clicked"
            IsVisible="False"
            Text="{x:Static lang:AppResources.valide}" />
    </Grid>
</ContentPage>